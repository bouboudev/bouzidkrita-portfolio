---
interface Props {
  index: string;
  eyebrow: string;
  title: string;
  description?: string;
  headingId?: string;
}

const { index, eyebrow, title, description, headingId } = Astro.props;
---

<div class="reveal max-w-2xl">
  <p class="eyebrow">{index} — {eyebrow}</p>
  <h2 class="title-lg mt-3" id={headingId}>{title}</h2>
  {description && <p class="muted mt-4 text-base leading-relaxed">{description}</p>}
</div>
