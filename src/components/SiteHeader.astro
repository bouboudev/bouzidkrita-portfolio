---
import { SITE, NAV_LINKS } from '../data/site';
import Icon from './Icon.astro';

const pathname = Astro.url.pathname;
// Normalise pour comparer avec/sans slash final (racine "/" exclue).
const norm = (p: string) => (p.length > 1 ? p.replace(/\/+$/, '') : p);
const current = norm(pathname);
const isActive = (href: string) => {
  const target = norm(href);
  return current === target || current.startsWith(target + '/');
};
---

<header class="site-header wrap flex h-16 items-center justify-between sm:h-20">
  <a href="/" class="font-display shrink-0 text-lg font-semibold tracking-tight" style="font-family: var(--font-display)" aria-label="Accueil — Bouzid Krita">
    Bouzid&nbsp;Krita<span class="link-accent">.</span>
  </a>

  <nav class="hidden items-center gap-7 lg:flex" aria-label="Navigation principale">
    {NAV_LINKS.map((link) => (
      <a
        href={link.href}
        aria-current={isActive(link.href) ? 'page' : undefined}
        class:list={[
          'nav-link text-sm transition-colors',
          isActive(link.href) ? 'font-semibold link-accent' : 'muted hover:text-inherit',
        ]}
      >
        {link.label}
      </a>
    ))}
  </nav>

  <div class="flex shrink-0 items-center gap-2">
    <a
      href={SITE.github}
      target="_blank"
      rel="noopener noreferrer"
      class="muted icon-link hidden min-h-[44px] min-w-[44px] items-center justify-center rounded-full p-2 sm:inline-flex"
      aria-label="GitHub (nouvel onglet)"
    >
      <Icon name="github" />
    </a>
    <a
      href={SITE.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="muted icon-link hidden min-h-[44px] min-w-[44px] items-center justify-center rounded-full p-2 sm:inline-flex"
      aria-label="LinkedIn (nouvel onglet)"
    >
      <Icon name="linkedin" />
    </a>
    <button
      id="theme-btn"
      type="button"
      class="inline-flex min-h-[44px] items-center rounded-full border px-4 text-xs font-semibold"
      style="border-color: var(--color-line)"
      aria-label="Basculer entre thème clair et sombre"
    >
      ◐ Thème
    </button>
    <button
      id="menu-btn"
      type="button"
      class="menu-btn inline-flex min-h-[44px] min-w-[44px] items-center justify-center gap-2 rounded-full border px-4 text-sm font-semibold lg:hidden"
      style="border-color: var(--color-line)"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="menu-mobile"
    >
      <span class="menu-icon" aria-hidden="true"><span></span><span></span><span></span></span>
      <span class="menu-label">Menu</span>
    </button>
  </div>
</header>

<div id="menu-mobile" class="mobile-menu" hidden>
  <div class="mobile-menu-backdrop" data-menu-close aria-hidden="true"></div>
  <nav class="mobile-menu-panel wrap" aria-label="Navigation mobile" id="menu-mobile-nav">
    <ul class="mobile-menu-list">
      {NAV_LINKS.map((link) => (
        <li>
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'mobile-menu-link',
              isActive(link.href) ? 'link-accent font-semibold' : undefined,
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <div class="mobile-menu-social">
      <a href={SITE.github} target="_blank" rel="noopener noreferrer" class="social-btn">GitHub ↗</a>
      <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer" class="social-btn">LinkedIn ↗</a>
    </div>
  </nav>
</div>
