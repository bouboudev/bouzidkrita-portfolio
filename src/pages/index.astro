---
import Layout from '../layouts/Layout.astro';
import SectionHead from '../components/SectionHead.astro';
import ProjectSpotlight from '../components/ProjectSpotlight.astro';
import { SITE } from '../data/site';
import { slugOf } from '../lib/slug';
import { getCollection } from 'astro:content';

const featured = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const exps = (await getCollection('experience'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<Layout>
  <!-- Hero -->
  <section class="hero-visual">
    <div class="wrap hero-calm">
      <p class="eyebrow reveal">Bouzid Krita — Développeur full-stack · Lille</p>
      <h1 class="title-xl reveal hero-title mt-5">Je développe et <span class="squiggle">fais évoluer</span> des applications web.</h1>
      <p class="reveal hero-desc mt-6 text-lg leading-relaxed">
        Du front-end au back-end, je développe et fais évoluer des produits avec
        Vue.js, TypeScript et Node.js.
      </p>
      <p class="meta-mono reveal hero-proof mt-6">3 ans d’expérience produit · Full-stack · Vue.js · Node.js</p>
      <div class="reveal hero-cta mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:gap-4">
        <a href="#selection" class="btn btn-solid hero-cta-btn">Voir mes projets</a>
        <a href="/contact/" class="btn btn-ghost hero-cta-btn" data-umami-event="contact-click">Me contacter</a>
      </div>
    </div>
  </section>

  <!-- Projets -->
  <section class="wrap py-20 md:py-24" aria-labelledby="titre-projets" id="selection">
    <SectionHead index="01" eyebrow="Sélection" title="Comment je fiabilise une application" description="Trois cas concrets : investiguer en conditions proches du réel, construire un socle d’interfaces testé, livrer un outil simple sans complexité inutile." headingId="titre-projets" />
    {featured[0] && (
      <div class="mt-8">
        <ProjectSpotlight
          num="01"
          title={featured[0].data.title}
          description={featured[0].data.description}
          href={`/projets/${slugOf(featured[0])}/`}
          meta={`${featured[0].data.category} · ${featured[0].data.status}`}
          tags={featured[0].data.stack}
          highlights={featured[0].data.highlights}
          pipeline={featured[0].id.includes('easytravel') ? ['Docker', 'Telegraf', 'Prometheus', 'Grafana'] : featured[0].id.includes('design-system') ? ['Atomes', 'Molécules', 'Organismes', 'Storybook'] : []}
          pipelineLabel={featured[0].id.includes('easytravel') ? 'Métriques' : 'Architecture'}
          variant="feature"
        />
      </div>
    )}
    <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2">
      {featured.slice(1, 3).map((p, i) => (
        <ProjectSpotlight
          num={String(i + 2).padStart(2, '0')}
          title={p.data.title}
          description={p.data.description}
          href={`/projets/${slugOf(p)}/`}
          meta={`${p.data.category} · ${p.data.status}`}
          tags={p.data.stack}
          variant="secondary"
        />
      ))}
    </div>
    <p class="muted mt-8 max-w-2xl leading-relaxed">Au quotidien : Vue.js, TypeScript, Node.js — Storybook, tests Cypress / Vitest / Playwright, monitoring Prometheus.</p>
    <p class="mt-6"><a href="/projets/" class="link-accent text-lg font-semibold">Tous les projets →</a></p>
  </section>

  <!-- Expérience -->
  <div class="band">
  <section class="wrap py-20 md:py-24" aria-labelledby="titre-parcours">
    <SectionHead index="02" eyebrow="Parcours" title="Une expérience ancrée dans le produit" description="De la feature à la maintenance : plateforme à fort trafic, intégration d’API et fiabilisation des parcours critiques." headingId="titre-parcours" />
    <ol class="timeline mt-8">
      {exps.map((e) => (
        <li class="reveal">
          <p class="meta-mono">{e.data.startDate}{e.data.endDate ? ` → ${e.data.endDate}` : ''} · {e.data.company}</p>
          <h3 class="mt-2 text-base font-semibold leading-snug">{e.data.role}</h3>
        </li>
      ))}
    </ol>
    <p class="mt-6"><a href="/parcours/" class="link-accent text-lg font-semibold">Parcours complet →</a></p>
  </section>
  </div>

  <!-- Contact -->
  <section class="wrap py-14 text-center md:py-16" aria-labelledby="titre-contact">
    <p class="eyebrow reveal">Contact</p>
    <h2 class="title-lg reveal mx-auto mt-3 max-w-xl" id="titre-contact">Besoin d’un développeur full-stack capable de comprendre l’existant et de le faire évoluer ?</h2>
    <p class="muted reveal mx-auto mt-4 max-w-xl">Basé à Lille, je conçois, maintiens et fiabilise des interfaces Vue.js avec une attention particulière portée à la qualité du code, aux tests et à la documentation.</p>
    <div class="reveal mt-8 flex flex-wrap justify-center gap-4">
      <a href="/contact/" class="btn btn-solid" data-umami-event="contact-click">Échanger avec moi</a>
      <a href={SITE.github} target="_blank" rel="noopener noreferrer" class="btn btn-ghost" data-umami-event="github-click">Voir mon GitHub ↗</a>
    </div>
  </section>
</Layout>
