---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../data/site';
---

<Layout title="Merci — Bouzid Krita" description="Votre message a bien été envoyé. Je vous répondrai dès que possible." noindex={true}>
  <section class="wrap max-w-2xl py-24 text-center md:py-32">
    <p class="eyebrow reveal">Message envoyé</p>
    <h1 class="title-xl reveal mx-auto mt-4">Merci pour votre message.</h1>
    <p class="muted reveal mx-auto mt-5 max-w-md leading-relaxed">
      Votre message a bien été envoyé. Je vous répondrai dès que possible.
    </p>
    <div class="reveal mt-10 flex flex-wrap justify-center gap-4">
      <a href="/" class="btn btn-solid">Retour à l’accueil</a>
    </div>
    <p class="reveal muted mt-8 text-sm">
      <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer" data-umami-event="linkedin-click">Me retrouver sur LinkedIn ↗</a>
    </p>
  </section>
  <script is:inline>
    window.addEventListener('load', () => {
      try { window.umami?.track('contact-success'); } catch (e) {}
    });
  </script>
</Layout>
